# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key — used only in trusted server-side contexts (cron jobs, admin RPCs)
# Get this from Supabase project settings > API > service_role key
# NEVER expose this to the client or commit it to version control
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cron secret — protects /api/cron/* routes from being called by anyone except Vercel
# Generate a random string: openssl rand -base64 32
# Add this same value to your Vercel project environment variables
CRON_SECRET=your_cron_secret

# Note: Never commit your actual .env.local file to version control
# Copy this file to .env.local and fill in your actual values
